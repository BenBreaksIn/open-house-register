DATABASE_URL=postgres://houseworks:houseworks@localhost:5432/houseworks
# Set a unique password of at least 16 characters. Never commit real credentials.
ADMIN_PASSWORD=
# A separate random 32–256 byte secret. Generate with: openssl rand -hex 32
# Keep stable across restarts and identical on every app instance.
SESSION_SECRET=
# Required only for Docker Compose. Choose a separate password without URL-reserved characters.
POSTGRES_PASSWORD=
# Public origin used by guest links and QR codes. Vercel can derive its deployment URL.
APP_BASE_URL=http://localhost:3030
PORT=3030
# Storage caps apply across all app instances. Export/delete old records as needed.
MAX_VISITORS_PER_EVENT=1000
MAX_VISITORS_TOTAL=10000
# For a self-hosted reverse proxy, list its actual source networks.
# Leave empty for direct local use, Vercel, or Render. Never trust all addresses.
TRUSTED_PROXY_CIDRS=
